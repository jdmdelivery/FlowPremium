# Local development
FLASK_DEBUG=1
SECRET_KEY=change-me-local-only

# PayPal Checkout (optional — app works without these)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# Cash App manual (optional)
# CASHAPP_TAG=$YourCashtag

# Square Cash App Pay (optional — hidden if missing)
# SQUARE_ACCESS_TOKEN=
# SQUARE_APPLICATION_ID=
# SQUARE_LOCATION_ID=
# SQUARE_ENV=sandbox

# Plan prices (optional overrides)
# PLAN_MONTHLY_AMOUNT=9.99
# PLAN_ANNUAL_AMOUNT=99.99

# Cloudflare R2 (set STORAGE_PROVIDER=r2 on Render)
# STORAGE_PROVIDER=local
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ACCOUNT_ID=
# R2_PUBLIC_BASE_URL=https://cdn.example.com
